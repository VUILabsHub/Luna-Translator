# Empty keys are intentional. Default mode demonstrates UI and protocol only.
DEMO_MODE=true
BIND_ADDRESS=127.0.0.1
PORT=8088
# Optional password override (at least 12 characters); otherwise generated once in the data volume.
ADMIN_PASSWORD=

# Real translation: set DEMO_MODE=false, then supply your own key.
LUNA_API_KEY=
LUNA_WS_URL=wss://simultrans.lunalabs.cn/v1/realtime/translate

# Optional independent source transcription and embedding scoring.
DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=
DASHSCOPE_REGION=cn-beijing
DASHSCOPE_ASR_URL=
# Use your workspace/region endpoint from the provider's official documentation.
DASHSCOPE_EMBEDDING_URL=
