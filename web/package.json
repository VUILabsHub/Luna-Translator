{
  "name": "simultrans-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Community Web frontend for real-time speech translation, history, replay and sharing",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && tsc -p tsconfig.node.json && vite build",
