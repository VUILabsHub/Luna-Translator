    "preview": "vite --host 0.0.0.0",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-sc": "5.3.0",
    "@fontsource-variable/noto-serif-sc": "5.3.0",
    "@fontsource/poppins": "5.3.0",
    "@simultrans/core": "*",
    "@simultrans/ui-shared": "*",
    "@vitejs/plugin-react": "6.0.4",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "web-vitals": "5.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/node": "^26.1.2",
    "@types/react": "19.2.17",
